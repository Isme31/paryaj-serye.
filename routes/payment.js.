// routes/payment.js (VÈSYON MONCASH + NATCASH POU GITHUB)
const express = require('express');
const axios = require('axios');
const router = express.Router();

let jwèBous = { "user_123": { balans: 250.00 } };

// ==================== SEKSYON MONCASH ====================

// 1. Depo MonCash
router.post('/moncash/deposit', async (req, res) => {
    const { userId, amount } = req.body;
    try {
        const tokenResponse = await axios.post('https://digicelgroup.com', {}, {
            auth: { username: process.env.MONCASH_CLIENT_ID, password: process.env.MONCASH_SECRET_KEY }
        });
        const accessToken = tokenResponse.data.access_token;
        const orderId = "MS_MON_" + Date.now();
        const paymentResponse = await axios.post('https://digicelgroup.com', { amount, orderId }, {
            headers: { 'Authorization': `Bearer ${accessToken}` }
        });
        const redirectUrl = `https://digicelgroup.com{paymentResponse.data.payment_token.token}`;
        res.json({ url: redirectUrl, orderId });
    } catch (error) {
        res.status(500).json({ error: "Sistèm MonCash lan gen yon pwoblèm kounye a" });
    }
});

// 2. Retrè MonCash
router.post('/moncash/withdraw', async (req, res) => {
    const { userId, amount, phoneToReceive } = req.body;
    if (!jwèBous[userId] || jwèBous[userId].balans < amount) {
        return res.status(400).json({ error: "Kòb nan bous la pa ase" });
    }
    try {
        const tokenResponse = await axios.post('https://digicelgroup.com', {}, {
            auth: { username: process.env.MONCASH_CLIENT_ID, password: process.env.MONCASH_SECRET_KEY }
        });
        const accessToken = tokenResponse.data.access_token;
        const payoutResponse = await axios.post('https://digicelgroup.com', { amount, receiver_phone: phoneToReceive, referenceId: "OUT_MON_" + Date.now() }, {
            headers: { 'Authorization': `Bearer ${accessToken}` }
        });
        jwèBous[userId].balans -= parseFloat(amount);
        res.json({ status: "Retrè MonCash la reyisi!", nouvoBalans: jwèBous[userId].balans });
    } catch (error) {
        res.status(500).json({ error: "Retrè MonCash la pa ka fèt kounye a" });
    }
});

